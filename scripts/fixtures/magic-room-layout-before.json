{
  "magic-room-screen": "<div id=\"magic-room-screen\" class=\"screen\">\n            <header class=\"app-header\">\n                <button class=\"back-btn\" data-target=\"home-screen\">‹</button>\n                <div class=\"title-container\">\n                    <h1 class=\"title\">魔法屋</h1>\n                </div>\n                <div class=\"placeholder\"></div>\n            </header>\n            <main class=\"content\">\n                <div class=\"kkt-settings-container\">\n                    <div style=\"margin-bottom: 15px; padding-top: 5px; padding-left: 8px;\">\n                        <div class=\"kkt-item-label\" style=\"font-weight: bold; color: var(--primary-color);\">系统提示词自定义</div>\n                        <p style=\"font-size: 11px; color: #999; margin: 5px 0 0;\">修改底层提示词结构，打造完全属于你的 AI 灵魂内核。</p>\n                    </div>\n\n                    <div class=\"kkt-group\">\n                        <div class=\"kkt-item\">\n                            <div class=\"kkt-item-label\">启用自定义系统提示词</div>\n                            <div class=\"kkt-item-control\">\n                                <label class=\"kkt-switch\">\n                                    <input type=\"checkbox\" id=\"magic-room-custom-prompt-enabled\">\n                                    <span class=\"kkt-slider\"></span>\n                                </label>\n                            </div>\n                        </div>\n\n                        <div id=\"magic-room-prompt-editor\" style=\"display: none;\">\n                            <div class=\"api-presets-embedded\" style=\"margin-bottom:15px; border-top: 1px solid #f5f5f5; padding-top: 15px;\">\n                                <div style=\"display:flex; align-items:center; gap:8px; margin-bottom:8px;\">\n                                    <label style=\"min-width:40px; color:#666; font-size: 14px;\">预设库</label>\n                                    <select id=\"magic-room-preset-select\" style=\"flex:1; padding:6px; border-radius:6px; border:1px solid #ddd;\">\n                                        <option value=\"\">— 选择 —</option>\n                                    </select>\n                                    <button type=\"button\" id=\"magic-room-apply-preset\" class=\"btn btn-primary btn-small\" style=\"padding: 6px 12px;\">加载</button>\n                                </div>\n                                <div style=\"display:flex; gap:8px; align-items:center; flex-wrap: wrap;\">\n                                    <button type=\"button\" id=\"magic-room-save-preset\" class=\"btn btn-small\" style=\"flex: 1;\">当前存为预设</button>\n                                    <button type=\"button\" id=\"magic-room-manage-presets\" class=\"btn btn-small\" style=\"flex: 1;\">管理</button>\n                                </div>\n                                <div id=\"magic-room-presets-modal\" style=\"display:none;position:fixed;inset:0;background:rgba(0,0,0,0.35);z-index:9999;align-items:center;justify-content:center;\">\n                                    <div style=\"width:640px;max-width:94%;background:var(--panel-bg,#fff);padding:16px;border-radius:8px;box-shadow:0 8px 24px rgba(0,0,0,0.12);\">\n                                        <h3 style=\"margin:0 0 12px 0;\">提示词预设管理</h3>\n                                        <div id=\"magic-room-presets-list\" style=\"max-height:360px;overflow:auto;border:1px solid #f0f0f0;padding:8px;border-radius:6px;\">\n                                        </div>\n                                        <div style=\"display:flex;gap:8px;margin-top:12px;justify-content:flex-end;\">\n                                            <button type=\"button\" id=\"magic-room-close-modal\" class=\"btn btn-primary\">关闭</button>\n                                        </div>\n                                    </div>\n                                </div>\n                            </div>\n                            <div class=\"prompt-studio-toolbar\" aria-label=\"提示词编辑方式\">\n                                <button type=\"button\" class=\"prompt-studio-mode-btn active\" data-prompt-mode=\"items\">条目编辑</button>\n                                <button type=\"button\" class=\"prompt-studio-mode-btn\" data-prompt-mode=\"source\">完整源码</button>\n                            </div>\n                            <div id=\"prompt-studio-items-panel\" class=\"prompt-studio-panel\">\n                                <div class=\"prompt-studio-actions\">\n                                    <button type=\"button\" id=\"prompt-studio-add-item\" class=\"btn btn-small btn-secondary\">添加条目</button>\n                                    <button type=\"button\" id=\"prompt-studio-open-variables\" class=\"btn btn-small btn-secondary\">变量库</button>\n                                    <button type=\"button\" id=\"prompt-studio-preview\" class=\"btn btn-small btn-secondary\">最终预览</button>\n                                    <button type=\"button\" id=\"prompt-studio-reset-items\" class=\"btn btn-small btn-secondary\">恢复默认条目</button>\n                                </div>\n                                <div id=\"prompt-studio-status\" class=\"prompt-studio-status\" aria-live=\"polite\"></div>\n                                <div id=\"prompt-studio-item-list\" class=\"prompt-studio-item-list\"></div>\n                            </div>\n                            <div id=\"prompt-studio-variables\" class=\"prompt-studio-drawer\" hidden=\"\">\n                                <div class=\"prompt-studio-drawer-head\">\n                                    <div>\n                                        <strong>变量库</strong>\n                                        <p>点击变量可插入到当前正在编辑的条目。</p>\n                                    </div>\n                                    <button type=\"button\" class=\"prompt-studio-icon-btn\" id=\"prompt-studio-close-variables\" aria-label=\"关闭变量库\">×</button>\n                                </div>\n                                <div id=\"prompt-studio-variable-list\"></div>\n                            </div>\n                            <div id=\"prompt-studio-preview-panel\" class=\"prompt-studio-drawer\" hidden=\"\">\n                                <div class=\"prompt-studio-drawer-head\">\n                                    <div>\n                                        <strong>最终提示词预览</strong>\n                                        <p id=\"prompt-studio-preview-meta\">选择角色后可查看真实变量结果。</p>\n                                    </div>\n                                    <button type=\"button\" class=\"prompt-studio-icon-btn\" id=\"prompt-studio-close-preview\" aria-label=\"关闭预览\">×</button>\n                                </div>\n                                <select id=\"prompt-studio-preview-character\" class=\"prompt-studio-preview-character\" aria-label=\"预览角色\"></select>\n                                <div id=\"prompt-studio-preview-warnings\" class=\"prompt-studio-preview-warnings\"></div>\n                                <pre id=\"prompt-studio-preview-content\" class=\"prompt-studio-preview-content\"></pre>\n                            </div>\n                            <div id=\"prompt-studio-source-panel\" class=\"kkt-item prompt-studio-source-panel\" style=\"flex-direction: column; align-items: stretch; padding-bottom: 15px; border-top: 1px solid #f5f5f5;\" hidden=\"\">\n                                <div style=\"display: flex; justify-content: space-between; align-items: center; margin-bottom: 8px;\">\n                                    <div class=\"kkt-item-label\" style=\"font-size: 13px;\">提示词模板</div>\n                                    <div style=\"display: flex; gap: 5px;\">\n                                        <button type=\"button\" id=\"magic-room-reset-prompt-btn\" class=\"btn btn-small btn-secondary\" style=\"padding: 4px 8px;\">恢复默认</button>\n                                    </div>\n                                </div>\n                                <p style=\"font-size: 11px; color: #888; margin: 0 0 8px 0; line-height: 1.4;\">\n                                    支持的变量：<br>\n                                    <code style=\"color:var(--primary-color);\">{{当前时间}}</code> <code style=\"color:var(--primary-color);\">{{世界书_前}}</code> <code style=\"color:var(--primary-color);\">{{世界书_中}}</code> <code style=\"color:var(--primary-color);\">{{世界书_后}}</code> <code style=\"color:var(--primary-color);\">{{角色名}}</code> <code style=\"color:var(--primary-color);\">{{用户称呼}}</code> <code style=\"color:var(--primary-color);\">{{角色状态}}</code> <code style=\"color:var(--primary-color);\">{{角色人设}}</code> <code style=\"color:var(--primary-color);\">{{用户人设}}</code> <code style=\"color:var(--primary-color);\">{{角色时间年龄通知}}</code> <code style=\"color:var(--primary-color);\">{{用户时间年龄通知}}</code> <code style=\"color:var(--primary-color);\">{{共同回忆}}</code> <code style=\"color:var(--primary-color);\">{{在线逻辑规则}}</code> <code style=\"color:var(--primary-color);\">{{输出格式}}</code> <code style=\"color:var(--primary-color);\">{{天气信息}}</code>\n                                </p>\n                                <textarea id=\"magic-room-custom-prompt\" rows=\"15\" style=\"width: 100%; padding: 10px; border: 1px solid #e0e0e0; border-radius: 8px; resize: vertical; font-size: 12px; font-family: monospace; box-sizing: border-box; background: #fafafa;\"></textarea>\n                            </div>\n                            \n                            <div style=\"display: flex; gap: 10px; margin-top: 15px;\">\n                                <button type=\"button\" id=\"magic-room-import-btn\" class=\"btn btn-secondary\" style=\"flex: 1;\">导入模板</button>\n                                <button type=\"button\" id=\"magic-room-export-btn\" class=\"btn btn-secondary\" style=\"flex: 1;\">导出模板</button>\n                                <input type=\"file\" id=\"magic-room-import-input\" accept=\".json\" style=\"display:none;\">\n                            </div>\n                        </div>\n                    </div>\n\n                    <details class=\"kkt-group\" id=\"magic-room-moments-prompts\" style=\"margin-top:12px;\">\n                        <summary class=\"kkt-item magic-moments-summary\">\n                            <span class=\"kkt-item-label\">动态能力提示词<span class=\"kkt-item-hint\">只注入角色已开启的能力；旧预设自动接入。这里修改的文字对所有预设生效。</span></span>\n                            <span class=\"magic-moments-toggle\" aria-hidden=\"true\"><span class=\"magic-moments-expand\">展开编辑</span><span class=\"magic-moments-collapse\">收起</span><span class=\"magic-moments-chevron\"></span></span>\n                        </summary>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-post\">自主发动态</label><textarea id=\"magic-moments-post\" data-moments-prompt=\"post\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-story\">自主发 Story</label><textarea id=\"magic-moments-story\" data-moments-prompt=\"story\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-browse\">自主浏览</label><textarea id=\"magic-moments-browse\" data-moments-prompt=\"browse\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-explicit-view\">明确请求观看</label><textarea id=\"magic-moments-explicit-view\" data-moments-prompt=\"explicitView\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-interact\">点赞与评论</label><textarea id=\"magic-moments-interact\" data-moments-prompt=\"interact\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-contacts\">角色人脉</label><textarea id=\"magic-moments-contacts\" data-moments-prompt=\"contacts\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-seen\">已看动态上下文</label><textarea id=\"magic-moments-seen\" data-moments-prompt=\"seen\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-unseen\">未看帖子索引</label><textarea id=\"magic-moments-unseen\" data-moments-prompt=\"unseen\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-post-generation\">发帖内容生成</label><textarea id=\"magic-moments-post-generation\" data-moments-prompt=\"postGeneration\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-autonomy\">自主活动判断</label><textarea id=\"magic-moments-autonomy\" data-moments-prompt=\"autonomy\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-chat-view-decision\">私聊中查看判断</label><textarea id=\"magic-moments-chat-view-decision\" data-moments-prompt=\"chatViewDecision\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-view-decision\">观看后互动判断</label><textarea id=\"magic-moments-view-decision\" data-moments-prompt=\"viewDecision\" class=\"magic-moments-prompt\"></textarea></div>\n                        <div class=\"kkt-item\" style=\"display:block;\"><label class=\"kkt-item-label\" for=\"magic-moments-friend-decision\">人脉好友判断</label><textarea id=\"magic-moments-friend-decision\" data-moments-prompt=\"friendDecision\" class=\"magic-moments-prompt\"></textarea></div>\n                    </details>\n\n                    <!-- ===== 后台保活设置 ===== -->\n                    <div style=\"margin: 20px 0 15px; padding-top: 18px; border-top: 2px solid #f0f0f0; padding-left: 8px;\">\n                        <div class=\"kkt-item-label\" style=\"font-weight: bold; color: var(--primary-color);\">运行保障设置</div>\n                        <p style=\"font-size: 11px; color: #999; margin: 5px 0 0;\">提高任务连续性；锁屏或切换应用时仍可能被系统挂起。</p>\n                    </div>\n\n                    <div class=\"kkt-group\">\n                        <div class=\"kkt-item\">\n                            <div class=\"kkt-item-label\">屏幕常亮 (Wake Lock)</div>\n                            <div class=\"kkt-item-control\">\n                                <label class=\"kkt-switch\">\n                                    <input type=\"checkbox\" id=\"keep-alive-code-enabled\">\n                                    <span class=\"kkt-slider\"></span>\n                                </label>\n                            </div>\n                        </div>\n                        <div class=\"kkt-item\">\n                            <div class=\"kkt-item-label\">生成时自动常亮</div>\n                            <div class=\"kkt-item-control\">\n                                <label class=\"kkt-switch\">\n                                    <input type=\"checkbox\" id=\"keep-alive-auto-wake-enabled\">\n                                    <span class=\"kkt-slider\"></span>\n                                </label>\n                            </div>\n                        </div>\n                        <div class=\"kkt-item\">\n                            <div class=\"kkt-item-label\">音频播放保活</div>\n                            <div class=\"kkt-item-control\">\n                                <label class=\"kkt-switch\">\n                                    <input type=\"checkbox\" id=\"keep-alive-audio-enabled\">\n                                    <span class=\"kkt-slider\"></span>\n                                </label>\n                            </div>\n                        </div>\n                        <div class=\"kkt-item\">\n                            <div class=\"kkt-item-label\">配置保活音频</div>\n                            <div class=\"kkt-item-control\">\n                                <button type=\"button\" id=\"open-keep-alive-audio-btn\" class=\"btn btn-secondary btn-small\" style=\"padding:6px 12px;\">配置</button>\n                            </div>\n                        </div>\n                    </div>\n\n                    <!-- ===== 系统通知设置 ===== -->\n                    <div style=\"margin: 20px 0 15px; padding-top: 18px; border-top: 2px solid #f0f0f0; padding-left: 8px;\">\n                        <div class=\"kkt-item-label\" style=\"font-weight: bold; color: var(--primary-color);\">系统级通知</div>\n                        <p style=\"font-size: 11px; color: #999; margin: 5px 0 0;\">开启后，收到消息时将弹出系统级弹窗通知，类似微信/QQ 的消息提醒。</p>\n                    </div>\n\n                    <div class=\"kkt-group\">\n                        <!-- 总开关 -->\n                        <div class=\"kkt-item\">\n                            <div class=\"kkt-item-label\">启用系统通知</div>\n                            <div class=\"kkt-item-control\">\n                                <label class=\"kkt-switch\">\n                                    <input type=\"checkbox\" id=\"sysnotif-enabled\">\n                                    <span class=\"kkt-slider\"></span>\n                                </label>\n                            </div>\n                        </div>\n\n                        <!-- 子设置区域 -->\n                        <div id=\"sysnotif-options\" style=\"display:none;\">\n\n                            <!-- 自定义发送方名称 -->\n                            <div class=\"kkt-item\" style=\"flex-direction: column; align-items: stretch; padding-bottom: 12px;\">\n                                <div class=\"kkt-item-label\" style=\"margin-bottom: 8px;\">通知显示名称</div>\n                                <input type=\"text\" id=\"sysnotif-sender-name\" placeholder=\"留空则使用角色自己的名字\" style=\"width:100%; padding:8px 10px; border:1px solid #e0e0e0; border-radius:8px; font-size:13px; box-sizing:border-box; background: #fafafa;\">\n                                <p style=\"font-size:11px; color:#aaa; margin:5px 0 0;\">例如填入「微信」「QQ」可模拟系统消息来源名称</p>\n                            </div>\n\n                            <!-- 显示头像 -->\n                            <div class=\"kkt-item\">\n                                <div class=\"kkt-item-label\">显示发送方头像</div>\n                                <div class=\"kkt-item-control\">\n                                    <label class=\"kkt-switch\">\n                                        <input type=\"checkbox\" id=\"sysnotif-show-avatar\">\n                                        <span class=\"kkt-slider\"></span>\n                                    </label>\n                                </div>\n                            </div>\n                            <div class=\"kkt-item\">\n                                <div class=\"kkt-item-label\">当前聊天页内通知<p style=\"font-size:12px;color:#999;margin:4px 0 0;\">开启后，即使在聊天详情页内也能收到系统通知</p></div>\n                                <div class=\"kkt-item-control\">\n                                    <label class=\"kkt-switch\">\n                                        <input type=\"checkbox\" id=\"sysnotif-in-chat-enabled\">\n                                        <span class=\"kkt-slider\"></span>\n                                    </label>\n                                </div>\n                            </div>\n\n                            <!-- 显示消息内容 -->\n                            <div class=\"kkt-item\">\n                                <div class=\"kkt-item-label\">显示消息内容预览</div>\n                                <div class=\"kkt-item-control\">\n                                    <label class=\"kkt-switch\">\n                                        <input type=\"checkbox\" id=\"sysnotif-show-content\">\n                                        <span class=\"kkt-slider\"></span>\n                                    </label>\n                                </div>\n                            </div>\n\n                            <!-- 通知权限 -->\n                            <div class=\"kkt-item\" style=\"flex-direction: column; align-items: stretch; padding-bottom: 10px;\">\n                                <div style=\"display: flex; gap: 10px; margin-bottom: 6px;\">\n                                    <button type=\"button\" id=\"sysnotif-request-permission\" class=\"btn btn-secondary\" style=\"flex: 1; font-size:13px;\">\n                                        申请系统通知权限\n                                    </button>\n                                    <button type=\"button\" id=\"sysnotif-test-btn\" class=\"btn btn-primary\" style=\"flex: 1; font-size:13px;\">\n                                        发送测试通知\n                                    </button>\n                                </div>\n                                <div id=\"sysnotif-permission-status\" style=\"font-size:12px; color:#999; padding: 0 2px;\"></div>\n                                <p style=\"font-size:11px; color:#bbb; margin:5px 0 0; line-height:1.5;\">iOS 用户需先将应用「添加到主屏幕」，再通过主屏幕图标打开后才能申请权限。</p>\n                            </div>\n\n                            <!-- 自定义推送服务器 -->\n                            <div class=\"kkt-item\" style=\"border-top: 1px solid #f5f5f5; padding-top: 10px;\">\n                                <div class=\"kkt-item-label\">使用自定义推送服务器\n                                    <span style=\"font-size:11px; color:#bbb; font-weight:normal;\">（选填，适合应用完全关闭时仍需推送）</span>\n                                </div>\n                                <div class=\"kkt-item-control\">\n                                    <label class=\"kkt-switch\">\n                                        <input type=\"checkbox\" id=\"sysnotif-custom-server\">\n                                        <span class=\"kkt-slider\"></span>\n                                    </label>\n                                </div>\n                            </div>\n\n                            <div id=\"sysnotif-server-options\" style=\"display:none;\">\n                                <div class=\"kkt-item\" style=\"flex-direction: column; align-items: stretch; padding-bottom: 12px;\">\n                                    <div class=\"kkt-item-label\" style=\"margin-bottom: 8px;\">推送服务器 URL</div>\n                                    <input type=\"url\" id=\"sysnotif-server-url\" placeholder=\"https://your-push-server.com/send\" style=\"width:100%; padding:8px 10px; border:1px solid #e0e0e0; border-radius:8px; font-size:13px; box-sizing:border-box; background: #fafafa;\">\n                                </div>\n                                <div class=\"kkt-item\" style=\"flex-direction: column; align-items: stretch; padding-bottom: 12px;\">\n                                    <div class=\"kkt-item-label\" style=\"margin-bottom: 8px;\">服务器 Key / Token</div>\n                                    <input type=\"password\" id=\"sysnotif-server-key\" placeholder=\"填入你的推送服务器鉴权 Key\" style=\"width:100%; padding:8px 10px; border:1px solid #e0e0e0; border-radius:8px; font-size:13px; box-sizing:border-box; background: #fafafa;\">\n                                </div>\n                            </div>\n\n                        </div>\n                    </div>\n\n                    <button type=\"button\" class=\"btn btn-primary\" id=\"magic-room-save-btn\" style=\"margin-top: 20px; width: 100%;\">\n                        <span class=\"btn-text\">保存魔法屋设置</span>\n                    </button>\n                </div>\n            </main>\n        </div>"
}
